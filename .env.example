# EasyKFZ24 – Umgebungsvariablen (Vorlage, KEINE echten Werte)
# Datei nach .env.local kopieren.

# Passwort für /admin (mindestens 12 Zeichen)
ADMIN_PASSWORD=
# Zufälliger Schlüssel für die Sitzungs-Cookies (mindestens 32 Zeichen):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Ablage für Datenbank und Uploads (Standard: ./data)
# DATA_DIR=

# Optional: Dienst für die Verfügbarkeit von Wunschkennzeichen (siehe src/server/plate-availability.ts)
# PLATE_AVAILABILITY_URL=
# PLATE_AVAILABILITY_KEY=

# Online-Zahlung über Stripe Checkout (Visa, Mastercard, PayPal, Klarna, Apple Pay, Google Pay)
# Methoden im Stripe-Dashboard aktivieren; Webhook auf /api/zahlung/webhook einrichten.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Öffentliche Adresse für Rück-Links von der Bezahlseite, z. B. https://easykfz24.de
# PUBLIC_BASE_URL=
