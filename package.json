{
  "name": "easykfz24",
  "version": "0.1.0",
  "private": true,
  "description": "EasyKFZ24 – Kfz online anmelden: Kundenseite und Auftragsverwaltung",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "plate-font": "node scripts/plate-font.mjs",
    "predev": "node scripts/plate-font.mjs --ensure",
    "dev": "next dev",
    "prebuild": "node scripts/plate-font.mjs --ensure",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "node scripts/plate-font.mjs --ensure",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/plate-font.mjs --ensure",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev --local"
  },
  "dependencies": {
    "next": "15.5.27",
    "nodemailer": "^10.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "22.18.6",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "opentype.js": "^1.3.4",
    "typescript": "5.9.2",
    "wawoff2": "^2.0.1",
    "wrangler": "^4.139.0"
  }
}
